        "id": "mqtt.1.side_entrance_door_status",
        "openValues": [
          "open"
        ]
      },
      {
        "key": "terrace",
        "id": "mqtt.1.terrace_door_status",
        "openValues": [
          "open"
        ]
      },
      {
        "key": "shed",
        "id": "mqtt.1.Garage.shedDoorStatus",
        "openValues": [
          "open"
        ]
      }
