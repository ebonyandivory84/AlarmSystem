      {
        "key": "terrace",
        "id": "mqtt.2.HumanDetection.CamTerrace",
        "activeValues": [
          "human detected",
          true
        ]
      }
    ]
  },
  "alarmCenter": {
    "display": {
      "id": "mqtt.1.AlarmCenter.Display",
      "clearId": "mqtt.1.AlarmCenter.ClearDisplay",
      "rotationMs": 2000,
      "idleSources": [
        "0_userdata.0.currentDateTime",
        "sainlogic.0.weather.current.outdoortemp"
      ]
    },
    "buzzer": {
      "id": "mqtt.1.AlarmCenter.Buzzer",
      "patterns": {
        "confirm": "confirm",
        "warn": "beep long 2x",
        "doorOpen": "beep 2x",
        "decline": "decline"
      }
    },
    "led": {
      "redId": "mqtt.1.AlarmCenter.LEDRingRed",
      "yellowId": "mqtt.1.AlarmCenter.LEDRingYellow",
      "standbyId": "mqtt.1.AlarmCenter.StandBy"
    },
    "motionSensorId": "mqtt.1.AlarmCenter.MotionSensor"
  },
  "auth": {
    "fingerprint": {
      "stateId": "mqtt.1.fingerprintDoorbell.lastLogMessage",
      "knownUsers": [
        "Sebastian R1",
        "Teresa R1"
      ],
      "cooldownMs": 3000,
      "disarmOnMatch": true
    },
    "pinCommands": [
      {
        "sequence": "*1",
        "action": "garageOpen"
      },
      {
        "sequence": "*2",
        "action": "garageClose"
      },
      {
        "sequence": "*4",
        "action": "pdlcOpen"
      },
      {
        "sequence": "*5",
        "action": "pdlcClose"
      }
    ]
  },
  "actuators": {
