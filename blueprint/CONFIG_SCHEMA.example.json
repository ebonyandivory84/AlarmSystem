    },
    "pdlc": {
      "id": "tuya.0.bf2bb23b342877f2e1maqy.1",
      "openValue": true,
      "closeValue": false
    }
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "instance": "telegram.1",
