    "triggerReason": "mqtt.1.AlarmCenter.AlarmTrigger",
    "panic": "0_userdata.0.AlarmSystem.panic"
  },
  "profiles": {
    "full": [
      "doors",
      "windows",
      "motions",
      "cameraHumans"
    ],
    "perimeter": [
      "doors",
      "windows"
    ]
  },
  "sensors": {
    "doors": [
      {
        "key": "entrance",
