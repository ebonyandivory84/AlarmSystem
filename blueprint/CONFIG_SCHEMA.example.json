      "sendAlarmText": true,
      "sendTriggerReason": true
    },
    "alexa": {
      "enabled": true,
      "speakId": "alexa2.0.Echo-Devices.90F0081872670ASA.Commands.speak"
    }
  },
  "cameras": [
    {
      "key": "backyard",
      "humanStateId": "mqtt.2.reolink.HumanDetection.CamBackyard",
