              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "sensors_presence": {
      "type": "panel",
      "label": "Sensors Presence",
      "items": {
        "_desc_presence": {
          "type": "staticText",
          "text": "Presence-Sensoren (z. B. Geofence/Anwesenheit), die zonenbasiert ausgewertet werden können. Frei erweiterbar über Add/Remove."
        },
        "presenceSensorsTable": {
          "type": "table",
          "label": "Presence sensors (Add/Remove)",
          "items": [
            {
