    "diagnostics": {
      "type": "panel",
      "label": "Diagnostics",
      "items": {
        "_desc_diag": {
          "type": "staticText",
          "text": "Diagnosehilfe: Ereignisprotokoll, aktive Case-ID und Quittierung. Diese Infos helfen bei Tests und Fehlersuche."
        },
        "_d1": {
          "type": "staticText",
          "text": "Eventlog liegt in alarmsystem.0.diagnostics.eventsJson"
        },
        "_d2": {
          "type": "staticText",
          "text": "Aktive Case-ID: alarmsystem.0.runtime.activeCaseId"
        },
        "_d3": {
          "type": "staticText",
          "text": "Quittierung über alarmsystem.0.commands.ackActiveCase=true"
        }
      }
    },
