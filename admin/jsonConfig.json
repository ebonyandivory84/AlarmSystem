{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "General",
      "items": {
        "_desc_general": {
          "type": "staticText",
          "text": "Grundparameter des Adapters: Entprellung, Delays, Heartbeat-Timeout und Simulationsmodus. Simulationsmodus schreibt keine echten Aktorwerte."
        },
        "debugLevel": {
          "type": "select",
          "label": "Debug level",
          "options": [
            {
              "label": "error",
              "value": "error"
            },
            {
              "label": "warn",
              "value": "warn"
            },
            {
              "label": "info",
              "value": "info"
            },
            {
              "label": "debug",
              "value": "debug"
            }
          ]
        },
        "defaultCountdownSec": {
          "type": "number",
          "label": "Default countdown (sec)",
          "min": 5,
          "max": 300
        },
        "eventDedupeMs": {
          "type": "number",
          "label": "Event dedupe (ms)",
          "min": 0,
          "max": 10000
        },
        "snapshotSendDelayMs": {
          "type": "number",
          "label": "Snapshot delay after trigger (ms)",
          "min": 0,
          "max": 60000
        },
        "snapshotBurstCount": {
          "type": "number",
          "label": "Snapshot burst count",
          "min": 1,
          "max": 10
        },
        "snapshotBurstIntervalMs": {
          "type": "number",
          "label": "Burst interval (ms)",
          "min": 500,
          "max": 60000
        },
        "defaultEntryDelaySec": {
          "type": "number",
          "label": "Default entry delay (sec)",
          "min": 0,
          "max": 600
        },
        "defaultExitDelaySec": {
          "type": "number",
          "label": "Default exit delay (sec)",
          "min": 0,
          "max": 600
        },
        "heartbeatTimeoutSec": {
          "type": "number",
          "label": "Heartbeat timeout (sec)",
          "min": 10,
          "max": 3600
        },
        "simulationMode": {
          "type": "checkbox",
          "label": "Simulation mode (no real actuator writes)"
        }
      }
    },
    "zones": {
      "type": "panel",
      "label": "Alarm Zones",
      "items": {
        "_desc_zones": {
          "type": "staticText",
          "text": "Hier definierst du zentrale Alarm-Datenpunkte und die Verzögerungen pro Zone. Entry Delay = Zeit bis Alarmauslösung nach Trigger, Exit Delay = Zeit bis Zone nach Scharf-Schalten aktiv wird."
        },
        "_z": {
          "type": "staticText",
          "text": "Sensoren/Detections erhalten pro Zeile eine Zone: perimeter, aussenhaut, innenraum."
        },
        "zoneDelaysTable": {
          "type": "table",
          "label": "Zone delays (Entry/Exit)",
          "items": [
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "number",
              "attr": "entryDelaySec",
              "title": "Entry delay sec"
            },
            {
              "type": "number",
              "attr": "exitDelaySec",
              "title": "Exit delay sec"
            }
          ]
        }
      }
    },
    "sensors_pir": {
      "type": "panel",
      "label": "Sensors PIR",
      "items": {
        "_desc_pir": {
          "type": "staticText",
          "text": "PIR-/Bewegungssensoren für Alarm-Trigger. Pro Zeile: Datenpunkt, aktive Werte und zugehörige Zone. Triggern nur, wenn die Zone scharf ist."
        },
        "pirSensorsTable": {
          "type": "table",
          "label": "PIR sensors (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "text",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "text",
              "attr": "activeValuesCsv",
              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "sensors_contacts": {
      "type": "panel",
      "label": "Sensors Door/Window",
      "items": {
        "_desc_contacts": {
          "type": "staticText",
          "text": "Tür-/Fensterkontakte für Alarm-Trigger. Active Values enthalten den Zustand, der als Alarmereignis zählt (z. B. open)."
        },
        "contactSensorsTable": {
