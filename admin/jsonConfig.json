              "options": [
                {
                  "label": "boolean",
                  "value": "boolean"
                },
                {
                  "label": "string",
                  "value": "string"
                }
              ]
            },
            {
              "type": "text",
              "attr": "detectValue",
              "title": "Detect value (for string mode)"
            }
          ]
        }
      }
    },
    "cameras": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "_desc_cameras": {
          "type": "staticText",
          "text": "Kameraliste mit IP, Stream-URL, Snapshot-URL und optionalen Alarm-/LED-Datenpunkten. Credentials können je Kamera gepflegt werden."
        },
        "camerasTable": {
          "type": "table",
