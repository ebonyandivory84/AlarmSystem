    "telegram": {
      "type": "panel",
      "label": "Telegram",
      "items": {
        "_desc_telegram": {
          "type": "staticText",
          "text": "Mehrere Telegram-Instanzen und beliebig viele Chat-Ziele pro Instanz. Ereignisse/Snapshots werden an die zugeordneten Chats gesendet."
        },
        "telegramInstancesTable": {
          "type": "table",
          "label": "Telegram instances (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "instance",
              "title": "Instance (e.g. telegram.1)"
            },
            {
              "type": "password",
              "attr": "token",
              "title": "Token (optional metadata)"
            }
          ]
        },
        "telegramTargetsTable": {
          "type": "table",
          "label": "Telegram targets (Add/Remove)",
          "items": [
            {
              "type": "text",
