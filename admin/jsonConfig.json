{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "General",
      "items": {
        "debugLevel": { "type": "select", "label": "Debug level", "options": ["error", "warn", "info", "debug"] },
        "defaultCountdownSec": { "type": "number", "label": "Default countdown (sec)", "min": 5, "max": 300 },
        "eventDedupeMs": { "type": "number", "label": "Event dedupe (ms)", "min": 0, "max": 10000 },
        "snapshotSendDelayMs": { "type": "number", "label": "Snapshot delay after trigger (ms)", "min": 0, "max": 60000 },
        "snapshotBurstCount": { "type": "number", "label": "Snapshot burst count", "min": 1, "max": 10 },
        "snapshotBurstIntervalMs": { "type": "number", "label": "Burst interval (ms)", "min": 500, "max": 60000 }
      }
    },
    "zones": {
      "type": "panel",
      "label": "Alarm Zones",
      "items": {
        "_z": { "type": "staticText", "text": "Sensoren/Detections erhalten pro Zeile eine Zone: perimeter, aussenhaut, innenraum." },
        "armStateId": { "type": "text", "label": "Legacy arm state datapoint" },
        "perimeterStateId": { "type": "text", "label": "Legacy perimeter state datapoint" },
        "triggerStateId": { "type": "text", "label": "Trigger text datapoint" },
        "sirenStateId": { "type": "text", "label": "Siren datapoint" }
      }
    },
    "sensors_pir": {
      "type": "panel",
      "label": "Sensors PIR",
      "items": {
        "pirSensorsTable": {
          "type": "table",
          "label": "PIR sensors (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "label", "title": "Label" },
            { "type": "text", "attr": "id", "title": "Datapoint ID" },
            { "type": "select", "attr": "zone", "title": "Zone", "options": ["perimeter", "aussenhaut", "innenraum"] },
            { "type": "text", "attr": "activeValuesCsv", "title": "Active Values CSV" }
          ]
        }
      }
    },
    "sensors_contacts": {
      "type": "panel",
      "label": "Sensors Door/Window",
      "items": {
        "contactSensorsTable": {
          "type": "table",
          "label": "Door/Window contacts (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "label", "title": "Label" },
            { "type": "text", "attr": "id", "title": "Datapoint ID" },
            { "type": "select", "attr": "zone", "title": "Zone", "options": ["perimeter", "aussenhaut", "innenraum"] },
            { "type": "text", "attr": "activeValuesCsv", "title": "Active Values CSV" }
          ]
        }
      }
    },
    "sensors_presence": {
      "type": "panel",
      "label": "Sensors Presence",
      "items": {
        "presenceSensorsTable": {
          "type": "table",
          "label": "Presence sensors (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "label", "title": "Label" },
            { "type": "text", "attr": "id", "title": "Datapoint ID" },
            { "type": "select", "attr": "zone", "title": "Zone", "options": ["perimeter", "aussenhaut", "innenraum"] },
            { "type": "text", "attr": "activeValuesCsv", "title": "Active Values CSV" }
          ]
        }
      }
    },
    "person_detection": {
      "type": "panel",
      "label": "Person Detection",
      "items": {
        "personDetectionTable": {
          "type": "table",
          "label": "Person detection datapoints (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "label", "title": "Label" },
            { "type": "text", "attr": "id", "title": "Datapoint ID" },
            { "type": "select", "attr": "zone", "title": "Zone", "options": ["perimeter", "aussenhaut", "innenraum"] },
            { "type": "select", "attr": "mode", "title": "Type", "options": ["boolean", "string"] },
            { "type": "text", "attr": "detectValue", "title": "Detect value (for string mode)" }
          ]
        }
      }
    },
    "cameras": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "camerasTable": {
          "type": "table",
          "label": "Cameras (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "label", "title": "Label" },
            { "type": "text", "attr": "ip", "title": "IP" },
            { "type": "text", "attr": "streamUrl", "title": "Stream URL" },
            { "type": "text", "attr": "snapshotUrl", "title": "Snapshot URL" },
            { "type": "text", "attr": "alarmDatapoint", "title": "Alarm datapoint" },
            { "type": "text", "attr": "ledDatapoint", "title": "LED datapoint" },
            { "type": "text", "attr": "personDetectionDp", "title": "Person detection datapoint" },
            { "type": "text", "attr": "username", "title": "Username" },
            { "type": "password", "attr": "password", "title": "Password" }
          ]
        }
      }
    },
    "actuators": {
      "type": "panel",
      "label": "Actuators",
      "items": {
        "actuatorsTable": {
          "type": "table",
          "label": "Actuators (Add/Remove)",
          "items": [
            { "type": "text", "attr": "key", "title": "Key" },
            { "type": "text", "attr": "id", "title": "Datapoint ID" },
            { "type": "text", "attr": "onValue", "title": "ON value" },
            { "type": "text", "attr": "offValue", "title": "OFF value" }
          ]
        },
        "displayId": { "type": "text", "label": "Display datapoint" },
        "clearDisplayId": { "type": "text", "label": "Clear display datapoint" },
        "buzzerId": { "type": "text", "label": "Buzzer datapoint" },
        "motionSensorId": { "type": "text", "label": "Motion sensor datapoint" },
        "ledRedId": { "type": "text", "label": "LED red datapoint" },
        "ledYellowId": { "type": "text", "label": "LED yellow datapoint" },
        "standbyId": { "type": "text", "label": "Standby datapoint" }
      }
    },
    "telegram": {
      "type": "panel",
      "label": "Telegram",
      "items": {
        "telegramInstancesTable": {
          "type": "table",
          "label": "Telegram instances (Add/Remove)",
          "items": [
            { "type": "text", "attr": "instance", "title": "Instance (e.g. telegram.1)" },
            { "type": "password", "attr": "token", "title": "Token (optional metadata)" }
          ]
        },
        "telegramTargetsTable": {
          "type": "table",
          "label": "Telegram targets (Add/Remove)",
          "items": [
            { "type": "text", "attr": "instance", "title": "Instance" },
            { "type": "text", "attr": "chatId", "title": "Chat ID" }
          ]
        }
      }
    },
    "advanced": {
      "type": "panel",
      "label": "Advanced JSON (Fallback)",
      "items": {
        "sensorsJson": { "type": "textarea", "label": "Legacy sensorsJson", "rows": 6 },
        "personDetectionJson": { "type": "textarea", "label": "Legacy personDetectionJson", "rows": 6 },
        "camerasJson": { "type": "textarea", "label": "Legacy camerasJson", "rows": 6 },
        "actuatorsJson": { "type": "textarea", "label": "Legacy actuatorsJson", "rows": 6 },
        "telegramInstancesJson": { "type": "textarea", "label": "Legacy telegramInstancesJson", "rows": 6 },
        "telegramTargetsJson": { "type": "textarea", "label": "Legacy telegramTargetsJson", "rows": 6 }
      }
    }
  }
}
