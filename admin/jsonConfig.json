    "diagnostics": {
      "type": "panel",
      "label": "Diagnostics",
      "items": {
        "_desc_diag": {
          "type": "staticText",
          "text": "Diagnose: Eventlog, aktive Case-ID, Sabotage-Hinweise, Regelansicht (IF/THEN) und Quittierung aktiver Fälle."
        },
        "_d_rules": {
          "type": "staticText",
          "text": "Regelansicht (WENN...DANN): alarmsystem.0.rules.ifThenText und alarmsystem.0.rules.ifThenJson"
        },
        "_d1": {
          "type": "staticText",
          "text": "Eventlog liegt in alarmsystem.0.diagnostics.eventsJson"
        },
        "_d2": {
          "type": "staticText",
          "text": "Aktive Case-ID: alarmsystem.0.runtime.activeCaseId"
        },
        "_d3": {
          "type": "staticText",
          "text": "Quittierung über alarmsystem.0.commands.ackActiveCase=true"
        }
      }
    },
    "alarmcenter_hi": {
      "type": "panel",
      "label": "AlarmCenter HI",
      "items": {
        "_desc_alarmcenter_hi": {
          "type": "staticText",
          "text": "Hardware-Interface des AlarmCenter-Terminals (Display, Buzzer, LEDs, Standby, zentrale Arm/Perimeter/Trigger/Sirene-DPs)."
        },
        "displayId": {
