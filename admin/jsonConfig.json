              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "person_detection": {
      "type": "panel",
      "label": "Person Detection",
      "items": {
        "_desc_pd": {
          "type": "staticText",
          "text": "Person-Detection-Datenpunkte. Mode boolean: true löst aus. Mode string: nur der eingetragene Detect Value löst aus."
        },
        "personDetectionTable": {
          "type": "table",
          "label": "Person detection datapoints (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "text",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
