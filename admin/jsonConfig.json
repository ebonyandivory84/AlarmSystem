{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "General",
      "items": {
        "_desc_general": {
          "type": "staticText",
          "text": "Grundparameter des Adapters: Entprellung, Delays, Heartbeat-Timeout und Simulationsmodus. WENN Simulation aktiv DANN werden Aktoren nicht real geschaltet, sondern nur protokolliert."
        },
        "debugLevel": {
          "type": "select",
          "label": "Debug level",
          "options": [
            {
              "label": "error",
              "value": "error"
            },
            {
              "label": "warn",
              "value": "warn"
            },
            {
              "label": "info",
              "value": "info"
            },
            {
              "label": "debug",
              "value": "debug"
            }
          ]
        },
        "defaultCountdownSec": {
          "type": "number",
          "label": "Default countdown (sec)",
          "min": 5,
          "max": 300
        },
        "eventDedupeMs": {
          "type": "number",
          "label": "Event dedupe (ms)",
          "min": 0,
          "max": 10000
        },
        "snapshotSendDelayMs": {
          "type": "number",
          "label": "Snapshot delay after trigger (ms)",
          "min": 0,
          "max": 60000
        },
        "snapshotBurstCount": {
          "type": "number",
          "label": "Snapshot burst count",
          "min": 1,
          "max": 10
        },
        "snapshotBurstIntervalMs": {
          "type": "number",
          "label": "Burst interval (ms)",
          "min": 500,
          "max": 60000
        },
        "defaultEntryDelaySec": {
          "type": "number",
          "label": "Default entry delay (sec)",
          "min": 0,
          "max": 600
        },
        "defaultExitDelaySec": {
          "type": "number",
          "label": "Default exit delay (sec)",
          "min": 0,
          "max": 600
        },
        "heartbeatTimeoutSec": {
          "type": "number",
          "label": "Heartbeat timeout (sec)",
          "min": 10,
          "max": 3600
        },
        "simulationMode": {
          "type": "checkbox",
          "label": "Simulation mode (no real actuator writes)"
        },
        "cameraNightModeEnabled": {
          "type": "checkbox",
          "label": "Night mode for cameras (astro: dusk -> sunrise end)"
        },
        "cameraNightModeArmsCameras": {
          "type": "checkbox",
          "label": "Allow camera trigger by person detection in night mode (even if zones are disarmed)"
        }
      }
    },
    "zones": {
      "type": "panel",
      "label": "Alarm Zones",
      "items": {
        "_example_zones": {
          "type": "staticText",
          "text": "Beispiel ZoneDelay: zone=innenraum, entryDelaySec=20, exitDelaySec=10"
        },
        "_desc_zones": {
          "type": "staticText",
          "text": "Zonenverhalten und Delays: Entry Delay = Zeit vom Trigger bis Alarm, Exit Delay = Verzögerung beim Scharfstellen. WENN Zone scharf UND Trigger aktiv DANN Countdown/Alarm nach Zonenregeln."
        },
        "_z": {
          "type": "staticText",
          "text": "Sensoren/Detections erhalten pro Zeile eine Zone: perimeter, aussenhaut, innenraum."
        },
        "zoneDelaysTable": {
          "type": "table",
          "label": "Zone delays (Entry/Exit)",
          "items": [
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "number",
              "attr": "entryDelaySec",
              "title": "Entry delay sec"
            },
            {
              "type": "number",
              "attr": "exitDelaySec",
              "title": "Exit delay sec"
            }
          ]
        }
      }
    },
    "sensors_pir": {
      "type": "panel",
      "label": "Sensors PIR",
      "items": {
        "_example_pir": {
          "type": "staticText",
          "text": "Beispiel: key=entranceMotion | id=mqtt.1.entrance_motion_sensor | zone=innenraum | activeValuesCsv=motion detected"
        },
        "_desc_pir": {
          "type": "staticText",
          "text": "PIR-/Bewegungssensoren pro Zone. WENN Wert aus Active Values eintritt UND Zone scharf DANN Trigger."
        },
        "pirSensorsTable": {
          "type": "table",
          "label": "PIR sensors (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "state",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "text",
              "attr": "activeValuesCsv",
              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "sensors_contacts": {
      "type": "panel",
      "label": "Sensors Door/Window",
      "items": {
        "_example_contacts": {
          "type": "staticText",
          "text": "Beispiel: key=terraceDoor | id=mqtt.1.terrace_door_status | zone=aussenhaut | activeValuesCsv=open"
        },
        "_desc_contacts": {
          "type": "staticText",
          "text": "Tür-/Fensterkontakte pro Zone. WENN Kontaktzustand aus Active Values eintritt UND Zone scharf DANN Trigger."
        },
        "contactSensorsTable": {
          "type": "table",
          "label": "Door/Window contacts (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "state",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "text",
              "attr": "activeValuesCsv",
              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "sensors_presence": {
      "type": "panel",
      "label": "Sensors Presence",
      "items": {
        "_example_presence": {
          "type": "staticText",
          "text": "Beispiel: key=presenceHomeSebastian | id=0_userdata.0.presence_at_home.Sebastian | zone=perimeter | activeValuesCsv=true"
        },
        "_desc_presence": {
          "type": "staticText",
          "text": "Presence-Sensoren (Geofence/Anwesenheit). Diese Liste dient der Automationslogik (z. B. Auto-Arm, Heimstatus)."
        },
        "presenceSensorsTable": {
          "type": "table",
          "label": "Presence sensors (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "state",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "text",
              "attr": "activeValuesCsv",
              "title": "Active Values CSV"
            }
          ]
        }
      }
    },
    "person_detection": {
      "type": "panel",
      "label": "Person Detection",
      "items": {
        "_example_pd": {
          "type": "staticText",
          "text": "Beispiele: boolean -> mode=boolean (detectValue leer). string -> mode=string + detectValue=human detected"
        },
        "_desc_pd": {
          "type": "staticText",
          "text": "Person-Detection pro Zone. Mode=boolean: true löst aus. Mode=string: nur der eingetragene Detect Value löst aus."
        },
        "personDetectionTable": {
          "type": "table",
          "label": "Person detection datapoints (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "state",
              "attr": "id",
              "title": "Datapoint ID"
            },
            {
              "type": "select",
              "attr": "zone",
              "title": "Zone",
              "options": [
                {
                  "label": "perimeter",
                  "value": "perimeter"
                },
                {
                  "label": "aussenhaut",
                  "value": "aussenhaut"
                },
                {
                  "label": "innenraum",
                  "value": "innenraum"
                }
              ]
            },
            {
              "type": "select",
              "attr": "mode",
              "title": "Type",
              "options": [
                {
                  "label": "boolean",
                  "value": "boolean"
                },
                {
                  "label": "string",
                  "value": "string"
                }
              ]
            },
            {
              "type": "text",
              "attr": "detectValue",
              "title": "Detect value (for string mode)"
            }
          ]
        }
      }
    },
    "cameras": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "_example_cameras": {
          "type": "staticText",
          "text": "Beispiel Snapshot-URL: http://<ip>/...user={username}&password={password} | Stream: rtsp://{username}:{password}@<ip>:554/..."
        },
        "_desc_cameras": {
          "type": "staticText",
          "text": "Kamera-Definitionen: IP, Stream, Snapshot, Alarm-DP, LED-DP, PersonDetection-DP. WENN PersonDetection triggert DANN Snapshot/Telegram (und optional Alarm/LED)."
        },
        "camerasTable": {
          "type": "table",
          "label": "Cameras (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "key",
              "title": "Key"
            },
            {
              "type": "text",
              "attr": "label",
              "title": "Label"
            },
            {
              "type": "text",
              "attr": "ip",
              "title": "IP"
            },
            {
              "type": "text",
              "attr": "streamUrl",
              "title": "Stream URL"
            },
            {
              "type": "text",
              "attr": "snapshotUrl",
              "title": "Snapshot URL"
            },
            {
              "type": "state",
              "attr": "alarmDatapoint",
              "title": "Alarm datapoint"
            },
            {
              "type": "state",
              "attr": "ledDatapoint",
              "title": "LED datapoint"
            },
            {
              "type": "state",
              "attr": "personDetectionDp",
              "title": "Person detection datapoint"
            },
            {
              "type": "text",
              "attr": "username",
              "title": "Username"
            },
            {
              "type": "password",
              "attr": "password",
              "title": "Password"
            }
          ]
        }
      }
    },
    "telegram": {
      "type": "panel",
      "label": "Telegram",
      "items": {
        "_example_telegram": {
          "type": "staticText",
          "text": "Beispiel Instanz: telegram.1 | Beispiel Target: instance=telegram.1, chatId=<CHAT_ID>"
        },
        "_desc_telegram": {
          "type": "staticText",
          "text": "Mehrere Telegram-Instanzen und Chat-Ziele möglich. Nachrichten/Snapshots werden je zugeordnetem Ziel versendet."
        },
        "telegramInstancesTable": {
          "type": "table",
          "label": "Telegram instances (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "instance",
              "title": "Instance (e.g. telegram.1)"
            },
            {
              "type": "password",
              "attr": "token",
              "title": "Token (optional metadata)"
            }
          ]
        },
        "telegramTargetsTable": {
          "type": "table",
          "label": "Telegram targets (Add/Remove)",
          "items": [
            {
              "type": "text",
              "attr": "instance",
              "title": "Instance"
            },
            {
              "type": "text",
              "attr": "chatId",
              "title": "Chat ID"
            }
          ]
        }
      }
    },
    "advanced": {
      "type": "panel",
      "label": "Advanced JSON (Fallback)",
      "items": {
        "_desc_advanced": {
          "type": "staticText",
          "text": "Nur für Sonderfälle: Legacy-JSON-Fallback. Normalerweise die Tabellen verwenden."
        },
        "sensorsJson": {
          "type": "textarea",
          "label": "Legacy sensorsJson",
          "rows": 6
        },
        "personDetectionJson": {
          "type": "textarea",
          "label": "Legacy personDetectionJson",
